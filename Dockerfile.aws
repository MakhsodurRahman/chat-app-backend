# AWS Elastic Beanstalk Dockerfile
FROM eclipse-temurin:21-jre

WORKDIR /app

# Copy the pre-built JAR from the deployment package root
COPY realtime-notification-0.0.1-SNAPSHOT.jar app.jar

# Expose port 8080 (Matches Spring Boot default and EB Docker default)
EXPOSE 8080

# Run the application
ENTRYPOINT ["java", "-Dserver.port=8080", "-jar", "app.jar"]
